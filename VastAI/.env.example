# Vast account credentials are intentionally not used by MainFlow.
# Keep VAST_API_KEY only in the Vast CLI or provisioning environment.

# API key configured on the remote vLLM servers with --api-key.
VASTAI_INFERENCE_API_KEY=
VASTAI_INFERENCE_TIMEOUT_SECONDS=600

# Defaults assume three SSH tunnels bound to localhost.
VASTAI_CODER_BASE_URL=http://127.0.0.1:18000/v1
VASTAI_CODER_MODEL=mainflow-coder
VASTAI_CODER_CONTEXT_TOKENS=32768
VASTAI_CODER_MAX_OUTPUT_TOKENS=8192

VASTAI_VLM_BASE_URL=http://127.0.0.1:18001/v1
VASTAI_VLM_MODEL=mainflow-vlm

# Requires an OpenAI Images-compatible endpoint such as vLLM-Omni.
VASTAI_IMAGE_BASE_URL=http://127.0.0.1:18002/v1
VASTAI_IMAGE_MODEL=mainflow-image

MAINFLOW_FEATURE_PROVIDER=vastai
MAINFLOW_DESIGN_V2_PROVIDER=vastai
MAINFLOW_BLUEPRINT_PROVIDER=vastai
LLM_VISUAL_VALIDATION_PROVIDER=vastai
MAINFLOW_VISUAL_TARGET_AI=vast_image
