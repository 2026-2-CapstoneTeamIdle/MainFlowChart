# Feature code may still select OpenAI automatically when a key is present, but staged design and
# scene blueprint generation default to the local Gemma role so an unrelated API key never moves
# those two planning stages back to OpenAI.
MAINFLOW_FEATURE_PROVIDER=
MAINFLOW_DESIGN_V2_PROVIDER=local
LLM_DESIGN_V2_MODEL=gemma4-12b-it-qat-q4-0
MAINFLOW_BLUEPRINT_PROVIDER=local
LLM_BLUEPRINT_MODEL=gemma4-12b-it-qat-q4-0
# Optional override for the pre-design genre feature inference call. Empty inherits
# MAINFLOW_FEATURE_PROVIDER; use off to keep only features explicitly written by the user.
MAINFLOW_GENRE_FEATURE_PROVIDER=
MAINFLOW_CONDITION_FEATURE_PROVIDER=
LLM_CONDITION_FEATURE_ANALYSIS_MODEL=gemma4-12b-it-qat-q4-0

# Project checklist generation (30 items) and checklist-to-C# generation are separate roles.
LLM_FEATURE_CHECKLIST_GENERATION_PROVIDER=local
LLM_FEATURE_CHECKLIST_GENERATION_MODEL=gemma4-12b-it-qat-q4-0
LLM_UNITY_CHECKLIST_TEST_GENERATION_PROVIDER=local
LLM_UNITY_CHECKLIST_TEST_GENERATION_MODEL=qwen2.5-coder-7b-q5-k-m
MAINFLOW_DYNAMIC_TEST_GENERATION_ATTEMPTS=3

# OpenAI text/code generation. This same provider is inherited by project review, checklist
# repair, and the final game-quality validator unless their node-specific provider is set.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-6.1-terra
MAINFLOW_OPENAI_MODEL=gpt-6.1-terra
MAINFLOW_OPENAI_MAX_OUTPUT_TOKENS=8192
MAINFLOW_OPENAI_TIMEOUT_SECONDS=300
MAINFLOW_OPENAI_REASONING_EFFORT=low

# LocalAI fallback settings.
LOCAL_LLM_BASE_URL=http://127.0.0.1:8080/v1
LOCAL_LLM_MODEL=qwen2.5-coder-7b-q5-k-m
LOCAL_LLM_API_KEY=
LOCAL_LLM_CONTEXT_TOKENS=24576
# Optional for reasoning models such as Strata Qwen3.8. Structured JSON calls are
# faster and less likely to hit the output cap with none or low.
LOCAL_LLM_REASONING_EFFORT=none
LLM_TIMEOUT_SECONDS=300
MAINFLOW_LOCAL_MAX_OUTPUT_TOKENS=8192
# Gemma automatically uses json_object mode because LocalAI strict grammar can
# run until the token limit. Override only when the selected backend supports it.
MAINFLOW_LOCAL_STRUCTURED_ATTEMPTS=3
LOCAL_LLM_STRUCTURED_MODE=
# Short planning stages use bounded role-specific budgets so a malformed local
# response cannot consume the coder model's full 8192-token allowance repeatedly.
LLM_CONDITION_FEATURE_ANALYSIS_MAX_OUTPUT_TOKENS=2048
LLM_CONDITION_FEATURE_ANALYSIS_STRUCTURED_ATTEMPTS=1
LLM_CONDITION_FEATURE_ANALYSIS_TIMEOUT_SECONDS=180
LLM_GENRE_FEATURE_ENRICHMENT_MAX_OUTPUT_TOKENS=3072
LLM_GENRE_FEATURE_ENRICHMENT_STRUCTURED_ATTEMPTS=1
LLM_GENRE_FEATURE_ENRICHMENT_TIMEOUT_SECONDS=180
LLM_DESIGN_V2_MAX_OUTPUT_TOKENS=6144
LLM_DESIGN_V2_STRUCTURED_ATTEMPTS=1
LLM_DESIGN_V2_TIMEOUT_SECONDS=300
MAINFLOW_DESIGN_V2_CUSTOMIZATION_RETRIES=0
LLM_BLUEPRINT_MAX_OUTPUT_TOKENS=2048
LLM_BLUEPRINT_STRUCTURED_ATTEMPTS=1
LLM_BLUEPRINT_TIMEOUT_SECONDS=180
LLM_FEATURE_CHECKLIST_GENERATION_MAX_OUTPUT_TOKENS=3072
LLM_FEATURE_CHECKLIST_GENERATION_STRUCTURED_ATTEMPTS=1
LLM_FEATURE_CHECKLIST_GENERATION_TIMEOUT_SECONDS=240
LLM_UNITY_CHECKLIST_TEST_GENERATION_MAX_OUTPUT_TOKENS=6144
LLM_UNITY_CHECKLIST_TEST_GENERATION_STRUCTURED_ATTEMPTS=1
LLM_UNITY_CHECKLIST_TEST_GENERATION_TIMEOUT_SECONDS=600
# One missing feature gets one implementation plan plus at most two feedback-driven source
# candidates. Its whole generation is cancelled after seven minutes by default.
MAINFLOW_FEATURE_PLAN_ATTEMPTS=2
MAINFLOW_FEATURE_SOURCE_ATTEMPTS=3
MAINFLOW_FEATURE_GENERATION_BUDGET_SECONDS=420
LLM_FEATURE_CODE_GENERATION_MAX_OUTPUT_TOKENS=8192
LLM_FEATURE_CODE_GENERATION_STRUCTURED_ATTEMPTS=1
LLM_FEATURE_CODE_GENERATION_TIMEOUT_SECONDS=180
MAINFLOW_GAME_MAX_REPAIRS=4
# Context review retries malformed/incomplete LLM audits twice, then may repair and re-review once.
MAINFLOW_PROJECT_REVIEW_ATTEMPTS=2
MAINFLOW_PROJECT_REVIEW_REPAIRS=1
# Independent read-only audit after assets and final Unity validation.
MAINFLOW_GAME_VALIDATOR_ENABLED=1
LLM_GAME_QUALITY_VALIDATOR_PROVIDER=
MAINFLOW_GAME_VALIDATOR_ATTEMPTS=2
MAINFLOW_GAME_VALIDATOR_TOOL_ROUNDS=8
# This mode controls preliminary validation; final validation always requires Unity.
MAINFLOW_UNITY_VALIDATION_MODE=required
MAINFLOW_UNITY_RUNTIME_TESTS=1
MAINFLOW_UNITY_VALIDATION_TIMEOUT_SECONDS=300
# UNITY_EDITOR_PATH=C:/Program Files/Unity/Hub/Editor/6000.0.71f1/Editor/Unity.exe

# Optional: pin this value to reproduce one layout and visual variation exactly.
# When omitted, every new workflow project ID becomes the variation seed.
# MAINFLOW_GENERATION_SEED=demo-run-01

# Set MAINFLOW_FEATURE_PROVIDER=gemini to use Gemini instead.
GEMINI_API_KEY=
MAINFLOW_GEMINI_MODEL=gemini-3-flash-preview
MAINFLOW_GEMINI_TIMEOUT_SECONDS=90
MAINFLOW_GEMINI_THINKING_LEVEL=low
MAINFLOW_GEMINI_MAX_OUTPUT_TOKENS=8192

# Image generation backend: placeholder (default, no key) | openai | local.
MAINFLOW_IMAGE_BACKEND=placeholder
# Apply generated images to the Unity project: off (default, generate only) | on.
MAINFLOW_APPLY_IMAGE_ASSETS=off
# Animation sprite sheets (idle/run/jump...) for character sprites: on | off.
MAINFLOW_IMAGE_SPRITE_SHEETS=on
# auto (ai when the backend supports it, else transform) | ai | transform.
# ai adds one image API call per animation per character.
MAINFLOW_IMAGE_SPRITE_SHEET_MODE=auto
# Uses the same OPENAI_API_KEY only when MAINFLOW_IMAGE_BACKEND=openai.
MAINFLOW_OPENAI_IMAGE_MODEL=gpt-image-2.5-sunburst
MAINFLOW_OPENAI_IMAGE_QUALITY=medium
# Required only when MAINFLOW_IMAGE_BACKEND=local: an image model installed on the
# local OpenAI-compatible server (e.g. flux.1-dev-ggml in LocalAI). Gemma cannot draw.
MAINFLOW_LOCAL_IMAGE_MODEL=
# Empty uses LOCAL_LLM_BASE_URL, then http://127.0.0.1:8080/v1.
MAINFLOW_LOCAL_IMAGE_BASE_URL=
MAINFLOW_LOCAL_IMAGE_SIZE=512x512
MAINFLOW_LOCAL_IMAGE_STEPS=
MAINFLOW_LOCAL_IMAGE_TIMEOUT_SECONDS=600
# Whole-project game builder: pipeline (default), codex_cli, or claude_code.
# Codex CLI mode uses the current OS user's `codex login` session, not OPENAI_API_KEY.
MAINFLOW_GAME_BUILDER=pipeline
# MAINFLOW_CODEX_CLI_PATH=C:/path/to/codex.exe
MAINFLOW_CODEX_MODEL=gpt-5.6-luna
MAINFLOW_CODEX_REASONING_EFFORT=medium
MAINFLOW_CODEX_TIMEOUT_SECONDS=1800
MAINFLOW_CODEX_TOTAL_TIMEOUT_SECONDS=7200
MAINFLOW_CODEX_MAX_REPAIRS=6
MAINFLOW_GAME_QUALITY_REPAIRS=2
MAINFLOW_GAME_QUALITY_UNITY_REPAIRS=2
# Claude Code mode uses the current OS user's `claude` login, not ANTHROPIC_API_KEY.
# MAINFLOW_CLAUDE_CLI_PATH=C:/Users/you/AppData/Roaming/npm/claude.cmd
MAINFLOW_CLAUDE_MODEL=sonnet
MAINFLOW_CLAUDE_PERMISSION_MODE=acceptEdits
MAINFLOW_CLAUDE_MAX_TURNS=80
MAINFLOW_CLAUDE_TIMEOUT_SECONDS=1800
MAINFLOW_CLAUDE_TOTAL_TIMEOUT_SECONDS=7200
MAINFLOW_CLAUDE_MAX_REPAIRS=6
# Open a newly generated game/unity_project after the workflow exits, even on validation failure.
MAINFLOW_OPEN_UNITY_EDITOR=1
