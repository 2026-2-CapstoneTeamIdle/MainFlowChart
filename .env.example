# Required only when the request contains a mechanic that is not in the Unity module catalog.
GEMINI_API_KEY=
MAINFLOW_GEMINI_MODEL=gemini-3-flash-preview
MAINFLOW_GEMINI_TIMEOUT_SECONDS=90
MAINFLOW_GEMINI_THINKING_LEVEL=low
MAINFLOW_GEMINI_MAX_OUTPUT_TOKENS=8192

# Image generation backend: placeholder (default, no key) | openai | local.
MAINFLOW_IMAGE_BACKEND=placeholder
# Required only when MAINFLOW_IMAGE_BACKEND=openai.
OPENAI_API_KEY=
MAINFLOW_OPENAI_IMAGE_MODEL=gpt-image-1
MAINFLOW_OPENAI_IMAGE_QUALITY=medium
# Required only when MAINFLOW_IMAGE_BACKEND=local: an image model installed on the
# local OpenAI-compatible server (e.g. flux.1-dev-ggml in LocalAI). Gemma cannot draw.
MAINFLOW_LOCAL_IMAGE_MODEL=
# Empty uses LOCAL_LLM_BASE_URL, then http://127.0.0.1:8080/v1.
MAINFLOW_LOCAL_IMAGE_BASE_URL=
MAINFLOW_LOCAL_IMAGE_SIZE=512x512
MAINFLOW_LOCAL_IMAGE_STEPS=
MAINFLOW_LOCAL_IMAGE_TIMEOUT_SECONDS=600
