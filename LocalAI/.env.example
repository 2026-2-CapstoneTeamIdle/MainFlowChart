# Accept the Gemma license on Hugging Face before creating this token.
HF_TOKEN=

# Optional LocalAI runtime settings.
LOCALAI_DEBUG=false
LOCALAI_PRELOAD_MODELS_CONFIG=/configuration/preload-qwen-coder.yaml
LOCALAI_DEFAULT_MODEL=qwen2.5-coder-7b-q5-k-m
LOCAL_LLM_API_KEY=
LLM_TIMEOUT_SECONDS=300
MAINFLOW_FEATURE_PROVIDER=local
MAINFLOW_LOCAL_MAX_OUTPUT_TOKENS=2048

# Opt-in visual validation. This preload registers both the code LLM and VLM.
# LOCALAI_PRELOAD_MODELS_CONFIG=/configuration/preload-visual.yaml
MAINFLOW_VISUAL_VALIDATION=0
MAINFLOW_VISUAL_VALIDATION_ATTEMPTS=3
LLM_VISUAL_VALIDATION_PROVIDER=local
LLM_VISUAL_VALIDATION_MODEL=qwen3-vl-4b-instruct-q4-k-m
LLM_VISUAL_VALIDATION_MAX_TOKENS=768
