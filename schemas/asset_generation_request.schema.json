{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://2026-2-capstoneteamidle.example/schemas/asset_generation_request.schema.json",
  "title": "AssetGenerationRequest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "request_id",
    "source_design_id",
    "game_title",
    "genre",
    "asset_type",
    "image_style",
    "mood_style",
    "viewpoint",
    "reference_image",
    "output_directory",
    "assets"
  ],
  "properties": {
    "contract_version": {
      "const": "3.4.0"
    },
    "request_id": {
      "type": "string",
      "minLength": 1
    },
    "source_design_id": {
      "type": "string",
      "minLength": 1
    },
    "game_title": {
      "type": "string",
      "minLength": 1
    },
    "genre": {
      "enum": [
        "Platformer",
        "TowerDefense",
        "CardGame",
        "SurvivorLike",
        "VisualNovel",
        "RaisingSimulation"
      ]
    },
    "asset_type": {
      "enum": [
        "image",
        "sound"
      ]
    },
    "image_style": {
      "enum": [
        "Pixel Art",
        "Anime",
        "Cartoon",
        "Realistic",
        "Low Poly",
        "Custom"
      ]
    },
    "mood_style": {
      "enum": [
        "Cyberpunk",
        "Medieval",
        "Modern",
        "Fantasy",
        "Horror",
        "Cozy"
      ]
    },
    "viewpoint": {
      "enum": [
        "사이드뷰",
        "탑다운",
        "쿼터뷰",
        "고정 화면"
      ]
    },
    "reference_image": {
      "oneOf": [
        {
          "$ref": "#/$defs/artifactReference"
        },
        {
          "type": "null"
        }
      ]
    },
    "output_directory": {
      "type": "string",
      "enum": [
        "generated/images",
        "generated/sounds"
      ]
    },
    "assets": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/assetGenerationItem"
      }
    }
  },
  "$defs": {
    "artifactReference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract_version",
        "artifact_id",
        "project_id",
        "category",
        "relative_path",
        "media_type",
        "size_bytes",
        "sha256",
        "created_at",
        "producer"
      ],
      "properties": {
        "contract_version": {
          "const": "3.4.0"
        },
        "artifact_id": {
          "type": "string",
          "minLength": 1
        },
        "project_id": {
          "type": "string",
          "minLength": 1
        },
        "category": {
          "enum": ["image", "sound", "game", "data", "validation"]
        },
        "relative_path": {
          "type": "string",
          "minLength": 1
        },
        "media_type": {
          "type": "string",
          "minLength": 1
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "created_at": {
          "type": "string",
          "minLength": 1
        },
        "producer": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "assetGenerationItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "asset_id",
        "asset_type",
        "purpose",
        "description",
        "required",
        "suggested_filename",
        "unity_binding_key",
        "generation_spec"
      ],
      "properties": {
        "asset_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "asset_type": {
          "enum": [
            "image",
            "sound"
          ]
        },
        "purpose": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "required": {
          "type": "boolean"
        },
        "suggested_filename": {
          "type": "string",
          "minLength": 1
        },
        "unity_binding_key": {
          "type": "string",
          "pattern": "^asset_registry:[a-z][a-z0-9_]*$"
        },
        "generation_spec": {
          "oneOf": [
            { "$ref": "#/$defs/imageGenerationSpec" },
            { "$ref": "#/$defs/soundGenerationSpec" }
          ]
        }
      }
    },
    "imageGenerationSpec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "width", "height", "transparent", "sprite_mode", "pixels_per_unit"],
      "properties": {
        "kind": { "enum": ["sprite", "portrait", "ui", "tileset", "illustration", "background"] },
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 },
        "transparent": { "type": "boolean" },
        "sprite_mode": { "enum": ["single", "multiple"] },
        "pixels_per_unit": { "type": "integer", "minimum": 1 },
        "tile_width": { "type": "integer", "minimum": 1 },
        "tile_height": { "type": "integer", "minimum": 1 },
        "columns": { "type": "integer", "minimum": 1 },
        "rows": { "type": "integer", "minimum": 1 }
      }
    },
    "soundGenerationSpec": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind", "target_duration_seconds", "loop", "channels", "sample_rate_hz",
        "unity_load_type", "mixer_group", "spatial_blend"
      ],
      "properties": {
        "kind": { "enum": ["bgm", "sfx", "ui", "voice", "ambience"] },
        "target_duration_seconds": { "type": "number", "exclusiveMinimum": 0 },
        "loop": { "type": "boolean" },
        "channels": { "enum": ["mono", "stereo"] },
        "sample_rate_hz": { "type": "integer", "minimum": 8000 },
        "unity_load_type": { "enum": ["decompress_on_load", "compressed_in_memory", "streaming"] },
        "mixer_group": { "type": "string", "minLength": 1 },
        "spatial_blend": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    }
  }
}
