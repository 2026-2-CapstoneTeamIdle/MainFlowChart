{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://2026-2-capstoneteamidle.example/schemas/asset_generation_request.schema.json",
  "title": "AssetGenerationRequest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "request_id",
    "source_design_id",
    "game_title",
    "genre",
    "asset_type",
    "creative_style",
    "mood_style",
    "output_directory",
    "assets"
  ],
  "properties": {
    "contract_version": {
      "const": "3.0.0"
    },
    "request_id": {
      "type": "string",
      "minLength": 1
    },
    "source_design_id": {
      "type": "string",
      "minLength": 1
    },
    "game_title": {
      "type": "string",
      "minLength": 1
    },
    "genre": {
      "enum": [
        "Platformer",
        "TowerDefense",
        "CardGame",
        "SurvivorLike",
        "VisualNovel",
        "RaisingSimulation"
      ]
    },
    "asset_type": {
      "enum": [
        "image",
        "sound"
      ]
    },
    "creative_style": {
      "type": "string",
      "minLength": 1
    },
    "mood_style": {
      "enum": [
        "Cyberpunk",
        "Medieval",
        "Modern",
        "Fantasy",
        "Horror",
        "Cozy"
      ]
    },
    "output_directory": {
      "type": "string",
      "enum": [
        "generated/images",
        "generated/sounds"
      ]
    },
    "assets": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/assetGenerationItem"
      }
    }
  },
  "$defs": {
    "assetGenerationItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "asset_id",
        "asset_type",
        "purpose",
        "description",
        "required",
        "suggested_filename",
        "unity_binding_key"
      ],
      "properties": {
        "asset_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "asset_type": {
          "enum": [
            "image",
            "sound"
          ]
        },
        "purpose": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "required": {
          "type": "boolean"
        },
        "suggested_filename": {
          "type": "string",
          "minLength": 1
        },
        "unity_binding_key": {
          "type": "string",
          "pattern": "^asset_registry:[a-z][a-z0-9_]*$"
        }
      }
    }
  }
}
