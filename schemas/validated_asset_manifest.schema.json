{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ValidatedAssetManifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "manifest_version",
    "contract_version",
    "assets"
  ],
  "properties": {
    "manifest_version": {
      "const": "1.0.0"
    },
    "contract_version": {
      "const": "3.4.0"
    },
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "asset_id",
          "asset_type",
          "unity_binding_key",
          "artifact",
          "file_format"
        ],
        "properties": {
          "asset_id": {
            "type": "string",
            "minLength": 1
          },
          "asset_type": {
            "enum": [
              "image",
              "sound"
            ]
          },
          "unity_binding_key": {
            "type": "string",
            "minLength": 1
          },
          "artifact": {
            "$ref": "#/$defs/artifactReference"
          },
          "file_format": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  },
  "$defs": {
    "artifactReference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract_version",
        "artifact_id",
        "project_id",
        "category",
        "relative_path",
        "media_type",
        "size_bytes",
        "sha256",
        "created_at",
        "producer"
      ],
      "properties": {
        "contract_version": {
          "const": "3.4.0"
        },
        "artifact_id": {
          "type": "string",
          "minLength": 1
        },
        "project_id": {
          "type": "string",
          "minLength": 1
        },
        "category": {
          "enum": [
            "image",
            "sound",
            "game",
            "data",
            "validation"
          ]
        },
        "relative_path": {
          "type": "string",
          "minLength": 1
        },
        "media_type": {
          "type": "string",
          "minLength": 1
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "created_at": {
          "type": "string",
          "minLength": 1
        },
        "producer": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
